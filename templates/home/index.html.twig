{% extends 'base.html.twig' %}

{% block title %}Accueil{% endblock %}

{% block body %}
    <h1>{{ message }}</h1>

    {{ dump(listType) }}

    <p>nom : {{ listType.nom }}</p>
    <p>age : {{ listType.age }}</p>
    <p>ville : {{ listType.ville }}</p>

    {{ dump(listName) }}

    {% for item in listName %}
        <p>{{ item }}</p>
    {% endfor %}

{% endblock %}